<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tray app: a GUI process with no console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AiUsageBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ai-usagebar-win</AssemblyName>
    <!-- Generated by scripts/generate-icon.py. Same three-bar shape the tray
         draws, so the executable and the notification area match. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- CalVer: YEAR.MONTH.REVISION, month without a leading zero and revision
         restarting at 1 whenever the year or month changes. This is the single
         source of truth: AssemblyVersion and FileVersion are derived from it,
         and the release tag is this value prefixed with "v". -->
    <Version>2026.8.6</Version>

    <!-- Distribution is a single self-contained .exe, but those flags
         (SelfContained / PublishSingleFile / RID) are passed ONLY on the publish
         command line (see .github/workflows/release.yml). Setting them here
         unconditionally would force a RID on every `dotnet build`/`dotnet test`
         and break them. Plain build/test stays framework-dependent. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon embeds this as the executable's icon, which covers
         Explorer, the taskbar and Alt+Tab. Listing it as a Resource as well is
         what lets XAML reach it through pack://, for the custom title bar. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Rust CLI, bundled so a fresh install needs no `cargo install`.
         The release workflow builds it into Assets/ before publishing; local
         builds simply have no such file, and CliBinary falls back to PATH.
         Never commit this binary: see .gitignore. -->
    <EmbeddedResource Include="Assets\ai-usagebar.exe"
                      LogicalName="ai-usagebar.exe"
                      Condition="Exists('Assets\ai-usagebar.exe')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modern Fluent UI for WPF (Mica, dark theme, modern controls). -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- System-tray icon for WPF. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <!-- Generate the severity-tinted tray icon bitmap in code. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- TOML config: keeps the existing config.toml format compatible. -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
