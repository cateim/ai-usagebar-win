<Application
    x:Class="AiUsageBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AiUsageBar"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI: Fluent control styles + dark theme. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:LevelToBrushConverter x:Key="LevelToBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Palette mirrors the original Win32 dark theme. -->
            <SolidColorBrush x:Key="BgBrush" Color="#17181A" />
            <SolidColorBrush x:Key="CardBrush" Color="#232427" />
            <SolidColorBrush x:Key="LineBrush" Color="#303236" />
            <SolidColorBrush x:Key="TextBrush" Color="#E8E9EA" />
            <SolidColorBrush x:Key="MutedBrush" Color="#A6A7AA" />
            <SolidColorBrush x:Key="AccentBrush" Color="#8A8D93" />
            <SolidColorBrush x:Key="TrackBrush" Color="#2B2D30" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF8A80" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
