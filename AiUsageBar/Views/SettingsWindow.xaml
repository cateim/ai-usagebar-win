<ui:FluentWindow
    x:Class="AiUsageBar.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AI Usage - Settings"
    Width="480"
    Height="440"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The custom title bar does not inherit the executable's icon the way a
             stock window does, so it is set explicitly. -->
        <ui:TitleBar Grid.Row="0" Title="AI Usage - Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Padding="18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Refresh interval (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                <ui:NumberBox
                    x:Name="PollBox"
                    Minimum="15"
                    Maximum="86400"
                    SmallChange="15"
                    MaxDecimalPlaces="0"
                    Width="160"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12" />

                <TextBlock Text="Primary (tray tooltip)" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="PrimaryBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" />

                <CheckBox
                    x:Name="StartupBox"
                    Content="Start with Windows"
                    Foreground="{StaticResource TextBrush}"
                    Margin="0,4,0,16" />

                <!-- Collapsed by default: eleven providers expanded would bury
                     the three settings most people actually change. -->
                <Expander x:Name="KeysExpander" Header="API keys" IsExpanded="False" Margin="0,4,0,10">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock
                            Text="Leave a field blank to keep the current key. Claude and Codex sign in through their own CLI and need no key here."
                            Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Rows are built in code-behind: a PasswordBox cannot be
                             data-bound, and each row needs its own reference. -->
                        <StackPanel x:Name="KeysPanel" />

                        <TextBlock
                            x:Name="KeysUnavailableLabel"
                            Text="The CLI did not report its settings, so keys cannot be edited here."
                            Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <ui:Button Content="Open config.toml" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnOpenConfig" />
                    </StackPanel>
                </Expander>

                <TextBlock
                    x:Name="SaveErrorLabel"
                    Foreground="{StaticResource DangerBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Margin="0,0,0,10" />

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18">
            <ui:Button Content="Close" Click="OnClose" Margin="0,0,10,0" />
            <ui:Button Content="Save" Appearance="Primary" Click="OnSave" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
